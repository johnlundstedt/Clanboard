{
  "name": "clanboard-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:gen-schema": "tsx scripts/gen-d1-schema.ts",
    "db:migrate:sqlite": "tsx src/db/migrate-sqlite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.13.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250820.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "miniflare": "^3.20250111.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
